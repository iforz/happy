# Template only. Never commit a real secret. Install outside the repository.
HOST=127.0.0.1
PORT=3005
DB_PROVIDER=pglite
DATA_DIR=/var/lib/happy-web
PGLITE_DIR=/var/lib/happy-web/pglite
HAPPY_STATIC_DIR=/opt/happy-web/webapp
PUBLIC_URL=https://ai.iforz.cn
# Supply an approved strong production master secret through the service manager.
HANDY_MASTER_SECRET=REPLACE_WITH_APPROVED_PRODUCTION_SECRET
HAPPY_INJECT_HTML_CONFIG={"serverUrl":"https://ai.iforz.cn","disableAnalytics":true}
