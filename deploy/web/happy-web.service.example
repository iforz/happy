[Unit]
Description=Happy web and encrypted relay
After=network.target

[Service]
Type=simple
# Create/use an approved non-root service identity and owned state directory.
User=happy-web
WorkingDirectory=/opt/happy-web
EnvironmentFile=/etc/happy-web/production.env
ExecStartPre=/usr/bin/node /opt/happy-web/dist/standalone.mjs migrate
ExecStart=/usr/bin/node /opt/happy-web/dist/standalone.mjs serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/happy-web

[Install]
WantedBy=multi-user.target
